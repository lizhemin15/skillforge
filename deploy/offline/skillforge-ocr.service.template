[Unit]
Description=SkillForge 文档解析服务（RapidOCR PP-OCRv4，扫描件/Office 抽文本）
Documentation=https://github.com/lizhemin15/skillforge
After=network.target
# StartLimitIntervalSec=0：**永不放弃重启**。
#
# 为什么（2026-09-16 现场）：主服务只是这个单元的 HTTP 客户端。一旦 systemd 因为
# 「短时间内失败太多次」把它钉成 failed，主服务收到的就是 connection refused，
# 而用户看到的是「训练技能报错」——一个他完全无法自救的死局（要么得知道去
# systemctl reset-failed，要么得知道重装）。
# 这个单元的正常失败模式是「PyInstaller 解包目录被清 → 引擎坏 → 守卫非零退出」，
# 重启正是它的自愈手段；把重启掐掉等于把自愈能力掐掉。
# 崩溃循环有 journalctl 与 systemctl status 的 NRestarts 可见，比「静默死了好」。
StartLimitIntervalSec=0

[Service]
Type=simple
# TMPDIR 必须指向**我们自己的专用目录**，不能是 /tmp。
#
# 为什么（2026-09-16 线上事故）：ocrd 是 PyInstaller onefile，启动时把权重/配置解包到
# $TMPDIR/_MEIxxxx/。默认 TMPDIR=/tmp，而 /usr/lib/tmpfiles.d/tmp.conf 的规则是
# `D /tmp 1777 root root -`（没有保留期）—— systemd-tmpfiles-clean.timer 每天清一次，
# 运行中的 ocrd 解包目录就这样被删了。已加载进内存的模型照常推理，所以「小件正常」；
# 等到引擎回收重建（满 RECYCLE_EVERY 页）要重读 config.yaml 时才炸：
#   [Errno 2] No such file or directory: '/tmp/_MEIxxx/rapidocr_onnxruntime/config.yaml'
# 且引擎一旦重建失败就永久坏掉，此后每个需要 OCR 的请求都秒失败，直到重启进程。
# 用户可见后果：扫描件/混合 PDF 解析全废 → 训练素材为空 → 生成出与素材无关的技能。
# 放到 __PREFIX__/run/：tmpfiles 不管这里，且和 bin/、data/ 同前缀，不会跨盘。
# 最后一层兜底在 ocrd 代码里（运行时目录守卫：发现丢失就明确报错 + 非零退出让 systemd 重启）。
Environment=TMPDIR=__PREFIX__/run/ocr-tmp
ExecStartPre=/bin/mkdir -p __PREFIX__/run/ocr-tmp
ExecStartPre=/bin/chmod 700 __PREFIX__/run/ocr-tmp
ExecStart=__OCR_BIN__ --port __OCR_PORT__
# Restart=always + StartLimitIntervalSec=0（见 [Unit] 注释）：这个单元是主服务的外部依赖，
# 「永久 failed」对用户就是一个无解的 connection refused，因此永不放弃重启。
Restart=always
RestartSec=3
# 只监听 127.0.0.1（代码里写死），不对外暴露 —— 它不是公开接口，是主服务的内部依赖。
#
# 内存上限为什么是 2G：50 页扫描件实测峰值约 1.8G（引擎不回收时），给 1G 会被 cgroup
# OOM 杀掉，表现是"抽一半失败"。ocrd 内部每 20 页重建一次引擎压低峰值，这里留 2G 余量；
# 真超了宁可让 systemd 重启它，也不要它把整机内存吃光（主服务还在跑，重启只影响这一份解析）。
MemoryMax=2G

[Install]
WantedBy=multi-user.target
