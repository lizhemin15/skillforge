# SkillForge 配置参考（样例）
#
# ⚠️ 这个文件只是「有哪些开关、默认值多少」的说明书，**不要直接拿它当生产配置**。
#    真正的配置由 install.sh 自动生成在 <安装前缀>/skillforge.env，里面带着随机生成的密钥。
#    想改配置：改那个文件，然后 systemctl restart skillforge。
#
# 格式就是 systemd EnvironmentFile 格式：KEY=值，一行一个，# 开头是注释。
# 注意：值里**不要加引号**，systemd 不吃 shell 的引号语法（写 FOO="a b" 会把引号一起当值）。

# ---------- 服务本体 ----------
# 监听地址。:8092 = 所有网卡的 8092 端口；想只允许本机访问就写 127.0.0.1:8092
SKILLFORGE_ADDR=:8092
# 数据目录：技能文件、上传的模板、生成的临时文件都在这下面
SKILLFORGE_DATA_DIR=/opt/skillforge/data
# SQLite 数据库路径（默认在数据目录里的 skillforge.db）
SKILLFORGE_DB=/opt/skillforge/data/skillforge.db
# 对外可访问地址：生成下载链接/分享链接时写进 URL 的主机。
# install.sh 默认会探测本机内网 IP 填进来（装完会把结果念给你看）。
# 什么时候必须手动改：这台机器走反向代理/域名访问（填 https://你的域名），
# 或者有多张网卡、探测到的不是同事能访问的那张。填错的表现 = 页面能打开，
# 但下载/分享链接指向别的主机（本机自用会指向同事自己的电脑）。
# 只在本机浏览器使用才适合写 http://localhost:8092。
SKILLFORGE_PUBLIC_URL=http://内网IP或域名:8092

# 时区：日志时间、页面显示时间、定时任务都按它算。容器/最小化安装常是 UTC，
# 要按北京时间看日志就写 Asia/Shanghai（默认已内嵌时区库，离线可用）。
TZ=Asia/Shanghai

# ---------- 管理端账号 ----------
# 首次启动时用来建管理员。装好之后改密码走管理端页面，改这里没用（密码已存库）。
SKILLFORGE_ADMIN_USER=admin
SKILLFORGE_ADMIN_PASS=装的时候自动生成的随机密码

# 签名密钥：登录态的签名靠它。**换了等于所有人被登出**。
# 由 install.sh 随机生成（64 位十六进制），别手动改短。
# 这里故意不写「键=值」的样例，免得文档被凭据扫描误判成真凭据。

# ---------- PDF 字体 ----------
# PDF 渲染中文字形用的 .ttf 文件。留空则运行时自动扫描系统字体目录挑一个。
# 离线包会在 <安装前缀>/fonts 下自带一份并显式指到这里，这是最省心的做法。
# ⚠️ 必须是 .ttf：gopdf 读不了 .ttc（字体集合）和 .otf（CFF 轮廓）。
SKILLFORGE_PDF_FONT_FILE=/usr/local/share/fonts/skillforge/gbsn00lp.ttf

# 让 `-selftest` 能证明「沙箱里读不到这个文件」，从而证明密钥没被降权子进程看见
SKILLFORGE_ENV_FILE=/opt/skillforge/skillforge.env

# ---------- 模型能力 ----------
# 也可以在管理端网页上配（网页里的配置优先于这里的值）
SKILLFORGE_LLM_PROVIDER=
SKILLFORGE_LLM_BASE_URL=
SKILLFORGE_LLM_MODEL=
SKILLFORGE_LLM_API_KEY=

# ---------- 工具循环（智能体自主调用工具的能力）----------
# off = 回退成纯对话（不调工具）；注释掉或留空 = 开启
# SKILLFORGE_TOOLS=off
# off = 只关掉「沙箱里跑代码」，保留联网取数工具
# SKILLFORGE_EXEC=off
# off = 只关掉文档工具（填模板 / 生成文档），保留取数与代码能力
# SKILLFORGE_DOCS=off
# 一轮对话里最多让模型调几轮工具，1-20，默认 6。调大能处理更复杂任务，也更费 token。
# SKILLFORGE_TOOL_ROUNDS=6
# 单次工具执行超时，默认 20s
# SKILLFORGE_TOOL_TIMEOUT=20s
# 内网地址白名单：默认禁止工具访问内网/回环地址（防 SSRF），
# 确实要调内网接口就把它加进来，逗号分隔，支持主机名和 CIDR。
# SKILLFORGE_TOOL_HTTP_ALLOW=api.internal.corp,10.0.0.0/24
