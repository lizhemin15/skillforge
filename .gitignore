# ---- 编译产物 ----
/skillforge
/skillforge.bak.*
/docgen-test
*.exe
*.test

# ---- 运行时数据（技能内容 + SQLite 库）----
# 默认 SKILLFORGE_DATA_DIR 就是仓库根目录，所以这些必须挡住
/skills/**
!/skills/.gitkeep
*.db
*.db-wal
*.db-shm
/data/

# ---- 机密：真实环境变量文件绝不能进仓库 ----
skillforge.env
deploy.env
.env
.env.*

# ---- 开发笔记（内部调试记录，不入库）----
/memory/

# ---- 其它 ----
.DS_Store
*.log

# ---- 本地打包产物（离线包体积大，由 CI 产出并附到 Release，不入库）----
/dist/

# 真实手册素材：PDF 54MB + 扫描页 jpg 都是中间产物，不入库。
# 测试用「合成样本」替代（internal/skillgen/binary_sniff_test.go），不骑本机环境。
/testdata/manual/*.pdf
/testdata/manual/.*

# ocrd 构建产物（143M，只进离线包，不入库）
/dist-bin/

# Python 缓存（deploy/ocr 下的 __pycache__ 是本地跑脚本产生的垃圾）
__pycache__/
/dist-dl/
