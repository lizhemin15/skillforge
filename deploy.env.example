# SkillForge 环境变量示例
#
# 用法：复制为 skillforge.env，填入真实值，供 systemd / docker 加载
#   cp deploy.env.example /opt/skillforge/skillforge.env
#   chmod 600 /opt/skillforge/skillforge.env
#
# ⚠️ 千万不要把填好真实值的 skillforge.env 提交进仓库。

# ---- 服务 ----
SKILLFORGE_ADDR=:8092
# 技能内容与 SQLite 库的存放目录（默认 /root/skillforge）
SKILLFORGE_DATA_DIR=/opt/skillforge/data
# 可选：单独指定数据库路径，留空则用 <DATA_DIR>/skillforge.db
SKILLFORGE_DB=
# 对外可访问地址，用于生成下载链接
SKILLFORGE_PUBLIC_URL=http://localhost:8092

# ---- 管理端账号 ----
SKILLFORGE_ADMIN_USER=admin
SKILLFORGE_ADMIN_PASS=change-me-please
# JWT 签名密钥，务必改成随机串：openssl rand -hex 32
SKILLFORGE_JWT_SECRET=change-me-to-a-random-64-hex-string

# ---- LLM（可选；也可登录管理端在网页上配置，网页配置优先）----
SKILLFORGE_LLM_PROVIDER=openai-compatible
SKILLFORGE_LLM_BASE_URL=https://api.example.com/v1
SKILLFORGE_LLM_MODEL=gpt-4o-mini
SKILLFORGE_LLM_API_KEY=sk-your-key-here
